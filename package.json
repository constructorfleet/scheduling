{
  "name": "daycare-scheduler",
  "version": "0.1.0",
  "description": "Standalone scheduling application for managing daycare staff schedules",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build",
    "build:static": "sh scripts/build-static.sh",
    "deploy:static": "sh scripts/deploy-static.sh",
    "dev": "vite",
    "preview": "vite preview",
    "start": "vite preview",
    "test:e2e": "playwright test",
    "orchestrate": "ts-node orchestrate.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "scheduling",
    "daycare",
    "compliance",
    "rules-engine"
  ],
  "author": "Teagan",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "@playwright/test": "^1.45.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
