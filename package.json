{
    "name": "daycare-scheduler",
    "version": "0.5.1",
    "description": "Standalone scheduling application for managing daycare staff schedules",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "build:ui": "vite build",
        "build:static": "sh scripts/build-static.sh",
        "deploy:static": "sh scripts/deploy-static.sh",
        "dev": "npm run api:openapi:client &&npm run dev:setup && npm run dev:run",
        "dev:setup": "npm run api:generate && npm run api:migrate:deploy",
        "dev:run": "concurrently -k -n API,UI -c cyan,magenta \"npm run api:dev\" \"npm run ui:dev\"",
        "ui:dev": "vite",
        "api:dev": "tsx apps/api/src/server.ts",
        "api:build": "tsc -p apps/api/tsconfig.json",
        "api:generate": "prisma generate --schema prisma/schema.prisma",
        "api:migrate": "prisma migrate dev --name dev --schema prisma/schema.prisma",
        "api:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
        "api:create-admin": "tsx scripts/create-admin.ts",
        "api:openapi:client": "openapi --input apps/api/openapi.yaml --output apps/ui/data/generated --client fetch --useUnionTypes",
        "preview": "vite preview",
        "start": "vite preview",
        "test:e2e:server": "vite --host 127.0.0.1 --port 4174",
        "test:e2e": "playwright test",
        "orchestrate": "ts-node orchestrate.ts",
        "test:unit": "jest",
        "test": "npm run test:unit",
        "test:watch": "jest --watch",
        "lint": "eslint packages apps tests",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist coverage"
    },
    "keywords": [
        "scheduling",
        "daycare",
        "compliance",
        "rules-engine"
    ],
    "author": "Teagan",
    "license": "BUSL-1.1",
    "devDependencies": {
        "@playwright/test": "^1.45.0",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.0.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-react": "^4.0.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.0.0",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^30.2.0",
        "lint-staged": "^16.2.7",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.0.0",
        "vite": "^7.3.1"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/static": "^9.0.0",
        "@fastify/swagger": "^9.6.1",
        "@fastify/swagger-ui": "^5.2.5",
        "@prisma/adapter-better-sqlite3": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "ajv": "^8.12.0",
        "better-sqlite3": "^12.6.2",
        "fastify": "^5.7.4",
        "framer-motion": "^12.33.0",
        "openapi-typescript-codegen": "^0.30.0",
        "prisma": "^7.3.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "swagger-editor-dist": "^4.14.8",
        "tsx": "^4.21.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}