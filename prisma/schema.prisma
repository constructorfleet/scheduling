generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma-client"
}

datasource db {
  provider = "sqlite"
}

enum UserStatus {
  active
  disabled
}

enum Role {
  owner
  director
  scheduler
  viewer
}

model School {
  id                      String             @id @default(cuid())
  name                    String
  closedDays              Json
  openerCount             Int
  closerCount             Int
  minimumMedicalDelegated Int
  requireCurrentCpr       Boolean
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  scheduleTypes           ScheduleType[]
  jobTitles               JobTitle[]
  employees               Employee[]
  operatingHours          OperatingHours[]
  fieldTripTypes          FieldTripType[]
  scheduleWeeks           ScheduleWeek[]
  memberships             SchoolMembership[]
}

model ScheduleType {
  id            String  @id @default(cuid())
  schoolId      String
  value         String
  label         String
  ratioAdults   Int
  ratioStudents Int
  description   String?

  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, value])
}

model JobTitle {
  id                        String @id @default(cuid())
  schoolId                  String
  title                     String
  leaderQualified           Boolean
  requiresLeaderForOpenClose Boolean

  school                    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Employee {
  id                 String  @id @default(cuid())
  schoolId           String
  name               String
  jobTitle           String
  maxHoursPerDay     Int
  maxHoursPerWeek    Int
  employmentStatus   String
  medicallyDelegated Boolean
  cprCurrent         Boolean
  notes              String?
  availability       Json?
  requestedDaysOff   Json?

  school             School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model OperatingHours {
  id           String @id @default(cuid())
  schoolId     String
  scheduleType String
  daysOfWeek   Json
  open         String
  close        String

  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FieldTripType {
  id                    String  @id @default(cuid())
  schoolId              String
  name                  String
  adultRatioAdults      Int
  adultRatioStudents    Int
  leaderRatioAdults     Int
  leaderRatioStudents   Int
  policyCitationId      String?
  notes                 String?

  school                School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model ScheduleWeek {
  id                String   @id @default(cuid())
  schoolId          String
  label             String?
  status            String
  startDate         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduleDays      ScheduleDay[]
  segmentBlocks     SegmentBlock[]
  staffAssignments  StaffAssignment[]
  fieldTripEvents   FieldTripEvent[]
  auditEvents       AuditEvent[]
}

model ScheduleDay {
  id                        String  @id @default(cuid())
  scheduleWeekId            String
  date                      DateTime?
  dayOfWeek                 String
  scheduleType              String?
  enrollmentCount           Int?
  enrollmentSource          String?
  fieldTripEventId          String?
  operatingCapacityOverride Int?
  notes                     String?
  dayScheduleType           String?

  scheduleWeek              ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
}

model FieldTripEvent {
  id              String  @id @default(cuid())
  scheduleWeekId  String
  dayOfWeek       String
  segment         String
  scheduleDayId   String?
  fieldTripTypeId String?
  isNoFieldTrip   Boolean
  approverId      String?
  signedOffAt     DateTime?
  notes           String?

  scheduleWeek    ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
}

model SegmentBlock {
  id                  String @id @default(cuid())
  scheduleWeekId      String
  scheduleDayId       String?
  dayOfWeek           String
  segment             String
  startTime           String
  endTime             String
  childCount          Int
  status              String

  scheduleWeek        ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  staffAssignments    StaffAssignment[]
}

model StaffAssignment {
  id               String @id @default(cuid())
  scheduleWeekId   String
  segmentBlockId   String
  employeeId       String
  assignmentSource String
  startTime        String
  endTime          String
  status           String
  notes            String?

  scheduleWeek     ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  segmentBlock     SegmentBlock @relation(fields: [segmentBlockId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id             String      @id @default(cuid())
  scheduleWeekId String
  timestamp      DateTime
  user           String
  action         String
  citationId     String?
  citationName   String?
  citationDoc    String?
  citationSection String?
  notes          String?

  scheduleWeek   ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  displayName  String
  status       UserStatus         @default(active)
  failedLoginAttempts Int         @default(0)
  lockoutUntil DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships  SchoolMembership[]
  sessions     Session[]
}

model SchoolMembership {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
