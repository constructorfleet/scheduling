generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id                      String             @id @default(cuid())
  name                    String
  closedDays              Json
  openerCount             Int
  closerCount             Int
  minimumMedicalDelegated Int
  requireCurrentCpr       Boolean
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  scheduleTypes           ScheduleType[]
  jobTitles               JobTitle[]
  employees               Employee[]
  operatingHours          OperatingHours[]
  fieldTripTypes          FieldTripType[]
  scheduleWeeks           ScheduleWeek[]
}

model ScheduleType {
  id            String  @id @default(cuid())
  schoolId      String
  value         String
  label         String
  ratioAdults   Int
  ratioStudents Int
  description   String?

  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, value])
}

model JobTitle {
  id                        String @id @default(cuid())
  schoolId                  String
  title                     String
  leaderQualified           Boolean
  requiresLeaderForOpenClose Boolean

  school                    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Employee {
  id                 String  @id @default(cuid())
  schoolId           String
  name               String
  jobTitle           String
  maxHoursPerDay     Int
  maxHoursPerWeek    Int
  employmentStatus   String
  medicallyDelegated Boolean
  cprCurrent         Boolean
  notes              String?

  school             School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model OperatingHours {
  id           String @id @default(cuid())
  schoolId     String
  scheduleType String
  daysOfWeek   Json
  open         String
  close        String

  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FieldTripType {
  id                    String  @id @default(cuid())
  schoolId              String
  name                  String
  minAdultStudentRatio  Float
  minLeaderStudentRatio Float
  policyCitationId      String?
  notes                 String?

  school                School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model ScheduleWeek {
  id                String   @id @default(cuid())
  schoolId          String
  label             String?
  status            String
  startDate         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheduleDays      ScheduleDay[]
  segmentBlocks     SegmentBlock[]
  staffAssignments  StaffAssignment[]
  fieldTripEvents   FieldTripEvent[]
}

model ScheduleDay {
  id                        String  @id @default(cuid())
  scheduleWeekId            String
  date                      DateTime?
  dayOfWeek                 String
  scheduleType              String?
  enrollmentCount           Int?
  enrollmentSource          String?
  fieldTripEventId          String?
  operatingCapacityOverride Int?
  notes                     String?
  dayScheduleType           String?

  scheduleWeek              ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
}

model FieldTripEvent {
  id              String  @id @default(cuid())
  scheduleWeekId  String
  dayOfWeek       String
  segment         String
  scheduleDayId   String?
  fieldTripTypeId String?
  isNoFieldTrip   Boolean
  approverId      String?
  signedOffAt     DateTime?
  notes           String?

  scheduleWeek    ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
}

model SegmentBlock {
  id                  String @id @default(cuid())
  scheduleWeekId      String
  scheduleDayId       String?
  dayOfWeek           String
  segment             String
  startTime           String
  endTime             String
  childCount          Int
  status              String

  scheduleWeek        ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  staffAssignments    StaffAssignment[]
}

model StaffAssignment {
  id               String @id @default(cuid())
  scheduleWeekId   String
  segmentBlockId   String
  employeeId       String
  assignmentSource String
  startTime        String
  endTime          String
  status           String
  notes            String?

  scheduleWeek     ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  segmentBlock     SegmentBlock @relation(fields: [segmentBlockId], references: [id], onDelete: Cascade)
}
